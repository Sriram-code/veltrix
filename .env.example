# ---- Data (defaults point at ./data, mounted into the container at /app/data)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date (YYYY-MM-DD). Empty = system date.
APP_TODAY=

# ---- Paid LLM, used first when its key is set: openai | anthropic | gemini
LLM_PROVIDER=openai
# Optional model override for LLM_PROVIDER (defaults: gpt-4o-mini / claude-3-5-haiku-latest / gemini-2.0-flash)
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Free fallbacks, used automatically when no paid key is set
# Option A - Groq free tier, open-weight models (free key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Option B - Ollama, fully local open-source model, no key.
# Start it with: docker compose --profile local-llm up --build
# If Ollama is installed directly on your PC instead, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=28
# How many providers to try for one LLM call before giving up
LLM_MAX_ATTEMPTS=2
LLM_TIMEOUT_S=12

# ---- Retrieval: local open-source embeddings (BAAI/bge-small-en-v1.5 on CPU), no key
EMBEDDINGS=fastembed
CORPUS_TOKEN_BUDGET=2800
LOG_FILE=./logs/app.log
